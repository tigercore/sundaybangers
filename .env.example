# ── Frontend (Vite) ─────────────────────────────────────────────
# Supabase project URL + anon (public) key — safe to expose, RLS is read-only
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Netlify Functions (server-side only, never exposed) ─────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Spotify app credentials (create at https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Obtained once via: npm run spotify:token
SPOTIFY_REFRESH_TOKEN=
